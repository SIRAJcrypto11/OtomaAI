# NEXUS AI / OtomaAI — required and optional environment variables
# Copy to .env.local for development. Never commit real secrets.
# Generate the auth secret with: openssl rand -base64 32
# Generate the encryption key with: openssl rand -hex 32

# --- Auth (Auth.js v5) — REQUIRED in production ---
AUTH_SECRET=
# Canonical absolute URL of the app (needed behind proxies, e.g. Vercel sets it automatically)
AUTH_URL=

# --- Database (Vercel Postgres / Neon) — REQUIRED for registration, dashboard data, memory archive ---
# Auto-provisioned on Vercel; locally, create a DB and apply src/lib/db/schema.sql
POSTGRES_URL=

# --- Auth providers (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI providers (BYOK; at least one needed for live agent replies) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Redis short-term memory (optional; falls back to Postgres / disabled cache) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Telegram webhook integration (optional) ---
# Create a bot via @BotFather; webhook endpoint: /api/webhooks/telegram
TELEGRAM_BOT_TOKEN=
# Optional: random secret Telegram uses to authorize webhook updates
TELEGRAM_WEBHOOK_SECRET=

# --- Media (optional; Cloudinary auto-reads CLOUDINARY_URL on Vercel) ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- App secrets ---
# AES-256-GCM key for encrypting agent BYOK API keys at rest. REQUIRED in production.
ENCRYPTION_KEY=

# --- Feature flags ---
# Allow hardcoded demo accounts (admin@nexus.ai / owner / user) in a non-dev environment.
# Left unset in production: demo accounts are disabled automatically.
NEXUS_ALLOW_DEMO_AUTH=
